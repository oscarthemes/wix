<?xml version="1.0"?>
<ruleset name="Brigade Gravity Form Locator">
	<description>WordPress Coding Standards for the plugin.</description>
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/fixtures/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.2"/>
	<rule ref="WordPress">
		<!-- PSR-4-like class names inside a namespace; the autoloader maps them to WordPress file names. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="brigade-gravity-form-locator"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bgfl"/>
				<element value="Brigade\GravityFormLocator"/>
			</property>
		</properties>
	</rule>
</ruleset>
